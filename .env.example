# Participant / ledger (reserved for direct Ledger API reads)
VITE_LEDGER_URL=http://localhost:7575
VITE_PARTICIPANT_ID=participant1

# CIP-103 wallet gateway (RemoteAdapter rpcUrl for @canton-network/dapp-sdk)
VITE_WALLET_GATEWAY_URL=http://localhost:8080/api/v1

# Set to false to load live governance data from Scan (requires VITE_SCAN_URL)
VITE_USE_MOCK_VOTES=true

# Scan API (localnet: http://scan.localhost:4000/api/scan)
VITE_SCAN_URL=http://scan.localhost:4000/api/scan

# SV party for mocknet reads until wallet connect (AVR-2476); from GET /v0/dso sv_party_id
VITE_SV_PARTY_ID=
